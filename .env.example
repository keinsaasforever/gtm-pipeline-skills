# GTM Pipeline Skills — Environment Variables
# Copy this file to $HOME/.env.gtm (or anywhere, and export GTM_ENV_PATH=/that/path)
# Work emails, phone numbers and outreach run in keinsaas Sales Agent, not here.

# --- People & company search ---

# Pipe0 — company/people search (Amplemarket, Crustdata, Parallel). Sign up: https://pipe0.com
PIPE0_API_KEY=

# FullEnrich — people and company finder. Sign up: https://fullenrich.com
FULLENRICH_API_KEY=

# BetterContact — lead finder (optional). Sign up: https://bettercontact.rocks
BETTERCONTACT_API_KEY=

# --- Research & web ---

# SerpAPI — Google search results, domain lookups. Sign up: https://serpapi.com
SERPAPI_API_KEY=

# Parallel AI — FindAll discovery, Task Groups, web search.
#               Sign up: https://parallel.ai
PARALLEL_API_KEY=

# Apify — SimilarWeb traffic data. Sign up: https://apify.com
APIFY_API_KEY=

# Firecrawl — website scraping, agent-based extraction.
#             Sign up: https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- LLM routing ---

# OpenRouter — legacy, optional: only for signal_search.py --llm-backend openrouter
#              (the default backend scores in-context and needs no key). https://openrouter.ai
OPENROUTER_API_KEY=

# --- Meeting transcripts (revenue-intelligence skills, optional) ---

# Vexa — open-source meeting bot / transcription (Google Meet, Teams, Zoom).
#        Hosted: https://vexa.ai — or self-host and set VEXA_API_URL.
VEXA_API_KEY=
# VEXA_API_URL=https://api.cloud.vexa.ai
